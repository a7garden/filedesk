{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "filedesk",
  "version": "0.1.3",
  "identifier": "kr.seesun.filedesk",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "filedesk",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http://fdicon.localhost https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxMEM1QTM5RTA5RUU2ODQKUldTRTVwN2dPVm9NSWE2VHFaOW1QRVJyQmtlQzhuTFBqUlo2cGdlNFl1MEZQNVhpeUVIbk5pU0EK",
      "endpoints": ["https://github.com/a7garden/filedesk/releases/latest/download/latest.json"],
      "windows": { "installMode": "quiet" }
    }
  }
}
